# Gmail 설정
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx   # 16자리 앱 비밀번호 (아래 README 참고, 일반 로그인 비밀번호 아님)

# 구인사이트 발신 메일 필터 (콤마로 여러 개 나열 가능. 각 메일함에서 실제 발신자 주소 확인 후 수정)
# 예: 원티드만 쓸 때 SENDER_FILTER=wantedlab.com  (원티드 뉴스레터 실제 발신 도메인)
#     원티드+잡코리아 같이 쓸 때 SENDER_FILTER=wantedlab.com,jobkorea.co.kr
SENDER_FILTER=wantedlab.com

# "(광고) 000님을 위한 추천 프로젝트" 처럼 제목에 이 이름이 들어있는 메일만
# 여러 프로젝트가 나열된 개인 맞춤 추천 메일로 간주하고 처리
RECIPIENT_NAME=홍길동

# 안전장치: 최근 이 일수 이내에 받은 메일만 처리 대상으로 삼음
# (Gmail에서 실수로 오래된 메일을 대량으로 "안읽음" 처리해도 예전 것까지 다 처리되는 사고 방지)
LOOKBACK_DAYS=14

# PostgreSQL 설정
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_agent
DB_USER=postgres
# Docker(db 컨테이너)용 비밀번호 — 아무 값이나 지정 (로컬 Homebrew DB는 비밀번호를 검사하지 않음)
DB_PASSWORD=jobagent

# Claude API (원안 추출용)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Voyage AI (임베딩 생성용 — Anthropic이 공식 추천하는 임베딩 제공사, voyageai.com에서 발급)
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxx

# daily_report.py: 최근 며칠치 공고를 리포트에 포함할지
REPORT_LOOKBACK_DAYS=3

# daily_report.py: 보유 스킬 (LLM이 매칭도를 언급할 때 참고). 콤마로 나열
MY_SKILLS=Java, COBOL, Pro*C, 증권/파생상품 시스템, LangGraph, RAG, LLM
