# Gmail 설정
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx   # 16자리 앱 비밀번호 (아래 README 참고, 일반 로그인 비밀번호 아님)

# 구인사이트 발신 메일 필터 (콤마로 여러 개 나열 가능. 각 메일함에서 실제 발신자 주소 확인 후 수정)
# 예: 원티드만 쓸 때 SENDER_FILTER=wanted.co.kr
#     원티드+잡코리아 같이 쓸 때 SENDER_FILTER=wanted.co.kr,jobkorea.co.kr
SENDER_FILTER=wanted.co.kr

# PostgreSQL 설정
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_agent
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# Claude API (원안 추출용)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
